# Staging environment for manual QA (copy to `.env` before smoke tests).
# Public API: jarvis-api.cymonevo.com (see smart_assistant_api docker-compose.deploy.yml)

API_BASE_URL=https://jarvis-api.cymonevo.com
APP_ENV=staging
SENTRY_DSN=

# AccessKey from https://console.picovoice.ai/ for on-device wake-word
# detection (Porcupine). Leave empty to disable active listening.
PICOVOICE_ACCESS_KEY=
