# Copy this file to `.env` and fill in per-environment values.
# `.env` is git-ignored; `.env.example` is committed as a template.

API_BASE_URL=https://api.example.com

# Leave empty to disable Sentry error reporting.
SENTRY_DSN=

# One of: dev | staging | prod
APP_ENV=dev

# Which on-device wake-word engine active listening uses: picovoice | davoice.
# Neither works without its matching credentials below configured too.
WAKE_WORD_ENGINE=picovoice

# AccessKey from https://console.picovoice.ai/ for on-device wake-word
# detection (Porcupine). Leave empty to disable active listening.
PICOVOICE_ACCESS_KEY=

# License key + detection threshold from https://davoice.io/ (email
# info@davoice.io for a free POC/non-commercial key) for the DaVoice
# wake-word engine. Also requires assets/wake_word/jarvis.onnx to be replaced
# with a real DaVoice-trained model — see assets/wake_word/README.md.
DAVOICE_LICENSE_KEY=
DAVOICE_WAKE_WORD_THRESHOLD=0.7
