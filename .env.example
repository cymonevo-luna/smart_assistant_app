# Copy this file to `.env` and fill in per-environment values.
# `.env` is git-ignored; `.env.example` is committed as a template.

API_BASE_URL=https://api.example.com

# Leave empty to disable Sentry error reporting.
SENTRY_DSN=

# One of: dev | staging | prod
APP_ENV=dev

# AccessKey from https://console.picovoice.ai/ for on-device wake-word
# detection (Porcupine). Leave empty to disable active listening.
PICOVOICE_ACCESS_KEY=
